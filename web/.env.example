# Name in the page title and the PWA manifest.
VITE_PUBLIC_APP_NAME='fyai'
VITE_DEBUG='true'
# The bridge that runs fyai; the dev server forwards /api, /v1, /props and
# /slots to it.
VITE_PUBLIC_BRIDGE_ORIGIN='http://localhost:9331'
# Force the backend kind instead of probing the server: llama, fyai-bridge or
# fyai-remote. A page served from a host with no bridge needs it.
# VITE_PUBLIC_BACKEND='fyai-remote'
